<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Tc3ProjectTools.Plugins.Cleanup</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tc3ProjectTools.Abstractions\Tc3ProjectTools.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="default-cleanup-rules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPluginToRepository" AfterTargets="Build">
    <PropertyGroup>
      <RepositoryPluginInstallDir>$(MSBuildThisFileDirectory)..\..\Plugins\tc3.cleanup\</RepositoryPluginInstallDir>
    </PropertyGroup>

    <ItemGroup>
      <PluginArtifacts Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)ref\**\*.*" />
    </ItemGroup>

    <MakeDir Directories="$(RepositoryPluginInstallDir)" />
    <Copy SourceFiles="@(PluginArtifacts)"
          DestinationFiles="@(PluginArtifacts->'$(RepositoryPluginInstallDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
