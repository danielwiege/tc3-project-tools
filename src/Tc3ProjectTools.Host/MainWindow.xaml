<Fluent:RibbonWindow x:Class="Tc3ProjectTools.Host.MainWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:Fluent="urn:fluent-ribbon"
                     mc:Ignorable="d"
                     Title="TwinCAT3 Project Tools"
                     Height="900"
                     Width="1500"
                     WindowState="Maximized"
                     Background="#FFF4F5F7">
    <Fluent:RibbonWindow.Resources>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFDFEFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FFD7DDE5" />
        <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF9FBFC" Offset="0" />
            <GradientStop Color="#FFEFF4F8" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Fluent:RibbonWindow.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Fluent:Ribbon Grid.Row="0"
                       SelectedTabIndex="0"
                       BorderThickness="0,0,0,1"
                       BorderBrush="#FFD4DEE9">
            <Fluent:Ribbon.Menu>
                <Fluent:Backstage>
                    <Grid Width="1100" Height="700" Margin="20">
                        <TabControl>
                            <TabItem Header="Recent Workspaces">
                                <Grid Margin="16">
                                    <ListBox ItemsSource="{Binding RecentWorkspaces}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}"
                                                        Margin="0,0,0,8"
                                                        Padding="12,8"
                                                        Command="{Binding DataContext.OpenRecentWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Plugin Health">
                                <Grid Margin="16">
                                    <DataGrid ItemsSource="{Binding Plugins}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Plugin" Binding="{Binding Name}" Width="220" />
                                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120" />
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="140" />
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Logs">
                                <Grid Margin="16">
                                    <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="170" />
                                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" />
                                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="220" />
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Fluent:Backstage>
            </Fluent:Ribbon.Menu>

            <Fluent:Ribbon.QuickAccessItems>
                <Fluent:QuickAccessMenuItem IsChecked="True" Target="{Binding ElementName=OpenWorkspaceButton}" />
                <Fluent:QuickAccessMenuItem IsChecked="True" Target="{Binding ElementName=RefreshWorkspaceButton}" />
            </Fluent:Ribbon.QuickAccessItems>

            <Fluent:RibbonTabItem Header="Home">
                <Fluent:RibbonGroupBox Header="Workspace">
                    <Fluent:Button x:Name="OpenWorkspaceButton"
                                   Header="Open Workspace"
                                   Command="{Binding OpenWorkspaceCommand}">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="36" Height="36">
                                <TextBlock Text="WS" FontWeight="Bold" />
                            </Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Open Folder"
                                   Command="{Binding OpenFolderCommand}"
                                   SizeDefinition="Large,Middle,Small">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="36" Height="36">
                                <TextBlock Text="FD" FontWeight="Bold" />
                            </Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button x:Name="RefreshWorkspaceButton"
                                   Header="Refresh"
                                   Command="{Binding RefreshWorkspaceCommand}"
                                   SizeDefinition="Large,Middle,Small">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="36" Height="36">
                                <TextBlock Text="RF" FontWeight="Bold" />
                            </Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Current Workspace">
                    <TextBlock Width="260"
                               Text="{Binding WorkspaceTitle}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                    <TextBlock Width="260"
                               Margin="0,4,0,0"
                               Text="{Binding WorkspacePath}"
                               TextWrapping="Wrap"
                               Foreground="#FF536273" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem x:Name="TwinCatTab" Header="TwinCAT" />

            <Fluent:RibbonTabItem Header="Plugins">
                <Fluent:RibbonGroupBox Header="Installation">
                    <Fluent:Button Header="Open Plugin Folder" Command="{Binding OpenPluginFolderCommand}">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="36" Height="36">
                                <TextBlock Text="PL" FontWeight="Bold" />
                            </Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Open App Data" Command="{Binding OpenAppDataCommand}" SizeDefinition="Large,Middle,Small">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="36" Height="36">
                                <TextBlock Text="AD" FontWeight="Bold" />
                            </Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="Help">
                <Fluent:RibbonGroupBox Header="Diagnostics">
                    <Fluent:Button Header="Open Log Folder" Command="{Binding OpenLogFolderCommand}">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="36" Height="36">
                                <TextBlock Text="LG" FontWeight="Bold" />
                            </Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Open Session Log" Command="{Binding OpenSessionLogCommand}" SizeDefinition="Large,Middle,Small">
                        <Fluent:Button.LargeIcon>
                            <Viewbox Width="36" Height="36">
                                <TextBlock Text="SL" FontWeight="Bold" />
                            </Viewbox>
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Workspace" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding WorkspaceTitle}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding WorkspacePath}" TextWrapping="Wrap" Foreground="#FF536273" />
                        <TextBlock Margin="0,12,0,0" Text="{Binding ProjectCountText}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding TrackedFilesText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Loaded Plugins" FontSize="22" FontWeight="SemiBold" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Plugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="10" CornerRadius="10" Background="#FFF5F7FA" BorderBrush="#FFE0E5EC" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" Foreground="#FF5D6C7D" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Session" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Margin="0,10,0,0" Text="Current log file" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding SessionLogPath}" TextWrapping="Wrap" Foreground="#FF536273" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding ResultTitle}" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding ResultSummary}" TextWrapping="Wrap" Foreground="#FF536273" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,16,0,0"
                            Padding="12,6"
                            HorizontalAlignment="Left"
                            CornerRadius="999"
                            Background="#FFE8EEF6"
                            BorderBrush="#FFD4DEE9"
                            BorderThickness="1">
                        <TextBlock Text="{Binding ResultStatus}" FontWeight="SemiBold" />
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="10" Background="#FFF8FBFD" BorderBrush="#FFE0E5EC" BorderThickness="1">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer Grid.Row="3" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Visibility="{Binding HasTableResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding Tables}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,14" Padding="14" CornerRadius="12" Background="#FFF8FBFD" BorderBrush="#FFE0E5EC" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                                                    <DataGrid ItemsSource="{Binding View}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Padding="14"
                                    Margin="0,0,0,14"
                                    CornerRadius="12"
                                    Background="#FFF8FBFD"
                                    BorderBrush="#FFE0E5EC"
                                    BorderThickness="1"
                                    Visibility="{Binding HasSelectionItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Selectable Cleanup Items" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding SelectionSummary}" Foreground="#FF536273" />
                                    <DataGrid ItemsSource="{Binding SelectionItems}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Selected" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Rule" Binding="{Binding Group}" Width="140" />
                                            <DataGridTextColumn Header="Item" Binding="{Binding DisplayName}" Width="180" />
                                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="110" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding ToolActions}" Visibility="{Binding HasToolActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,12,12"
                                                Padding="16,8"
                                                Command="{Binding DataContext.ExecuteResultActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}"
                                                Content="{Binding Label}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Fluent:StatusBar Grid.Row="2" Margin="16,0,16,16">
            <Fluent:StatusBarItem Title="Workspace" Value="{Binding WorkspaceTitle}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding WorkspaceTitle}" />
            </Fluent:StatusBarItem>
            <Separator HorizontalAlignment="Left" />
            <Fluent:StatusBarItem Title="Projects" Value="{Binding ProjectCountText}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding ProjectCountText}" />
            </Fluent:StatusBarItem>
            <Separator HorizontalAlignment="Left" />
            <Fluent:StatusBarItem Title="Files" Value="{Binding TrackedFilesText}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding TrackedFilesText}" />
            </Fluent:StatusBarItem>
            <Fluent:StatusBarItem Title="Result Status" Value="{Binding ResultStatus}" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ResultStatus}" FontWeight="SemiBold" />
            </Fluent:StatusBarItem>
        </Fluent:StatusBar>
    </Grid>
</Fluent:RibbonWindow>
